{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://lean-assumptions.local/schema/cluster-report-v1.schema.json",
 "title": "lean-assumptions cluster report v1",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema_version",
  "tool_version",
  "cluster_model_version",
  "source",
  "summary",
  "trend",
  "clusters",
  "limitations"
 ],
 "properties": {
  "schema_version": {
   "const": "1"
  },
  "tool_version": {
   "type": "string"
  },
  "cluster_model_version": {
   "type": "string"
  },
  "source": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "schema_version",
    "lean_version",
    "policy_identifier",
    "transparency_mode",
    "declarations"
   ],
   "properties": {
    "schema_version": {
     "type": "string"
    },
    "lean_version": {
     "type": "string"
    },
    "policy_identifier": {
     "type": "string"
    },
    "transparency_mode": {
     "enum": [
      "none",
      "reducible",
      "recursive_normalization",
      "unknown"
     ]
    },
    "declarations": {
     "type": "number"
    }
   }
  },
  "summary": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "declarations_scanned",
    "failing_declarations",
    "failure_findings",
    "clusters"
   ],
   "properties": {
    "declarations_scanned": {
     "type": "number"
    },
    "failing_declarations": {
     "type": "number"
    },
    "failure_findings": {
     "type": "number"
    },
    "clusters": {
     "type": "number"
    }
   }
  },
  "trend": {
   "description": "FR-018/FR-019 remediation signals: failing-declaration counts per hidden/explicit/mixed bucket, report-derived failure families, and per-lane counts when lane metadata is present.",
   "type": "object",
   "additionalProperties": false,
   "required": [
    "hidden",
    "explicit_direct_prop",
    "explicit_typeclass",
    "mixed",
    "hidden_families",
    "explicit_direct_prop_families",
    "lanes"
   ],
   "properties": {
    "hidden": {
     "type": "integer",
     "minimum": 0
    },
    "explicit_direct_prop": {
     "type": "integer",
     "minimum": 0
    },
    "explicit_typeclass": {
     "type": "integer",
     "minimum": 0
    },
    "mixed": {
     "type": "integer",
     "minimum": 0
    },
    "hidden_families": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/trend_family"
     }
    },
    "explicit_direct_prop_families": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/trend_family"
     }
    },
    "lanes": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/lane_count"
     }
    }
   }
  },
  "clusters": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/failure_cluster"
   }
  },
  "limitations": {
   "type": "array",
   "items": {
    "type": "string"
   }
  }
 },
 "$defs": {
  "failure_cluster": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "source_class",
    "finding_kind",
    "category",
    "type_name",
    "module",
    "lane",
    "declaration_count",
    "finding_count",
    "declarations"
   ],
   "properties": {
    "source_class": {
     "enum": [
      "direct_prop",
      "package",
      "proof_carrying_data",
      "typeclass",
      "alias",
      "unknown",
      "other"
     ]
    },
    "finding_kind": {
     "type": "string"
    },
    "category": {
     "type": "string"
    },
    "type_name": {
     "type": [
      "string",
      "null"
     ]
    },
    "module": {
     "type": [
      "string",
      "null"
     ]
    },
    "lane": {
     "type": [
      "string",
      "null"
     ]
    },
    "declaration_count": {
     "type": "number"
    },
    "finding_count": {
     "type": "number"
    },
    "declarations": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  },
  "trend_family": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "type_name",
    "declarations"
   ],
   "properties": {
    "type_name": {
     "oneOf": [
      {
       "type": "null"
      },
      {
       "type": "string"
      }
     ]
    },
    "declarations": {
     "type": "integer",
     "minimum": 1
    }
   }
  },
  "lane_count": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "lane",
    "declarations"
   ],
   "properties": {
    "lane": {
     "type": "string"
    },
    "declarations": {
     "type": "integer",
     "minimum": 1
    }
   }
  }
 }
}
