{
  "version": 2,
  "description": "Performance baseline for representative CLI audits: per-case medians over `runs` executions must stay under reference_ms x regression_factor (regression detection) and under max_ms (absolute ceiling). References are local medians with headroom; update them only with the change that justifies the shift.",
  "cases": [
    {
      "name": "single_pure_data_declaration",
      "modules": [
        "LeanAssumptionsTest.Fixtures"
      ],
      "declarations": [
        "LeanAssumptionsTest.Fixtures.noPropBearingAssumptions"
      ],
      "format": "json",
      "extra_args": [
        "--allow-unknowns"
      ],
      "max_ms": 30000,
      "reference_ms": 3500
    },
    {
      "name": "representative_assumption_surface_batch",
      "modules": [
        "LeanAssumptionsTest.Fixtures"
      ],
      "declarations": [
        "LeanAssumptionsTest.Fixtures.packageBinder",
        "LeanAssumptionsTest.Fixtures.nestedPackageBinder",
        "LeanAssumptionsTest.Fixtures.classBinder",
        "LeanAssumptionsTest.Fixtures.subtypeBinder",
        "LeanAssumptionsTest.Fixtures.sigmaBinder",
        "LeanAssumptionsTest.Fixtures.psigmaBinder"
      ],
      "format": "json",
      "extra_args": [
        "--allow-package",
        "LeanAssumptionsTest.Fixtures.ProofPackage",
        "--allow-package",
        "LeanAssumptionsTest.Fixtures.NestedPackage",
        "--allow-package",
        "Subtype",
        "--allow-package",
        "Sigma",
        "--allow-package",
        "PSigma",
        "--allow-typeclasses",
        "--allow-unknowns"
      ],
      "max_ms": 60000,
      "reference_ms": 4500
    }
  ],
  "runs": 3,
  "regression_factor": 5
}
